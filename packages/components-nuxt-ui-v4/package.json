{
  "name": "@lionad/cx-components-nuxt-ui-v4",
  "version": "0.1.0",
  "description": "cx material components based on Nuxt UI",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsgo --tsdk ../../node_modules/.pnpm/typescript@7.0.2/node_modules/typescript --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@vueuse/core": "^14.3.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "@vue/shared": "^3.5.0",
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-vue": "workspace:*",
    "@popperjs/core": "^2.11.8",
    "@vueuse/integrations": "^14.3.0",
    "defu": "^6.1.7",
    "fuse.js": "^7.5.0",
    "lodash-es": "^4.18.1",
    "ohash": "^2.0.11",
    "tailwind-merge": "^3.6.0",
    "v-calendar": "^3.1.2",
    "vue-demi": "^0.14.10",
    "zod": "^4.4.3"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts"
}
