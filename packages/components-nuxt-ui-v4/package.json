{
  "name": "@lionad/cx-components-nuxt-ui-v4",
  "version": "0.1.0",
  "description": "cx material components based on Nuxt UI v4",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsgo --tsdk ../../node_modules/.pnpm/typescript@7.0.2/node_modules/typescript --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-vue": "workspace:*",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@vueuse/core": "^14.3.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.10.0",
    "vue": "^3.5.0"
  }
}
