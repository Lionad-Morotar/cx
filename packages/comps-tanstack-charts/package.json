{
  "name": "@lionad/cx-comps-tanstack-charts",
  "version": "0.1.0-alpha.9",
  "description": "cx material components wrapping TanStack Charts (@tanstack/charts/vue)",
  "keywords": [
    "charts",
    "schema-driven",
    "tanstack-charts",
    "vue"
  ],
  "homepage": "https://github.com/Lionad-Morotar/cx#readme",
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/cx/issues"
  },
  "author": "Lionad-Morotar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lionad-Morotar/cx.git",
    "directory": "packages/comps-tanstack-charts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsgo --tsdk ../../node_modules/.pnpm/typescript@7.0.2/node_modules/typescript --noEmit"
  },
  "dependencies": {
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-stream": "workspace:*",
    "@lionad/cx-vue": "workspace:*",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@tanstack/charts": "^0.14.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@vueuse/core": "^14.3.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "@tanstack/charts": "^0.14.0",
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "vue": "^3.5.0"
  }
}
