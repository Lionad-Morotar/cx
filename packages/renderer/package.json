{
  "name": "@lionad/cx-render",
  "version": "0.1.0",
  "description": "cx renderer: schema-driven Vue renderer",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style": "./dist/style.css"
  },
  "scripts": {
    "build": "vp pack && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsgo --tsdk ../../node_modules/typescript --noEmit"
  },
  "dependencies": {
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-vue": "workspace:*",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@vueuse/core": "^14.3.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ]
}
