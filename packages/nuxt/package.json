{
  "name": "@lionad/cx-nuxt",
  "version": "0.1.0",
  "description": "Nuxt module for cx",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": "./dist/types.d.mts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsgo --noEmit",
    "prepublishOnly": "nuxt-module-build build"
  },
  "dependencies": {
    "@lionad/cx-components": "workspace:*",
    "@lionad/cx-components-nuxt-ui-v2": "workspace:*",
    "@lionad/cx-components-nuxt-ui-v4": "workspace:*",
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-render": "workspace:*",
    "@lionad/cx-vue": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.0",
    "nuxt": "^4.5.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40"
  }
}
