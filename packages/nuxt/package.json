{
  "name": "@lionad/cx-nuxt",
  "version": "0.1.0-alpha.8",
  "description": "Nuxt module for cx",
  "author": "Lionad-Morotar",
  "keywords": [
    "schema-driven",
    "nuxt-module",
    "low-code",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lionad-Morotar/cx.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/cx/issues"
  },
  "homepage": "https://github.com/Lionad-Morotar/cx#readme",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./types": "./dist/types.d.mts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "nuxt-module-build build"
  },
  "dependencies": {
    "@lionad/cx-definition": "workspace:*",
    "@lionad/cx-render": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.0",
    "nuxt": "^4.5.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.40"
  }
}
