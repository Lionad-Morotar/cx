{
  "name": "@lionad/cx-stream",
  "version": "0.1.0-alpha.8",
  "description": "Streaming structured-render pipeline: incrementally parse incomplete LLM JSON into renderable cx component trees",
  "author": "Lionad-Morotar",
  "keywords": [
    "streaming",
    "llm",
    "incremental-json",
    "schema-driven",
    "vue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lionad-Morotar/cx.git",
    "directory": "packages/stream"
  },
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/cx/issues"
  },
  "homepage": "https://github.com/Lionad-Morotar/cx#readme",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0",
    "remove-markdown": "^0.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
