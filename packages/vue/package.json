{
  "name": "@lionad/cx-vue",
  "version": "0.1.0-alpha.0",
  "description": "cx Vue runtime: composables and shared runtime components",
  "author": "Lionad-Morotar",
  "keywords": [
    "vue",
    "composables",
    "schema-driven",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lionad-Morotar/cx.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Lionad-Morotar/cx/issues"
  },
  "homepage": "https://github.com/Lionad-Morotar/cx#readme",
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style": "./dist/style.css",
    "./styles": "./src/styles/index.scss"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsgo --tsdk ../../node_modules/.pnpm/typescript@7.0.2/node_modules/typescript --noEmit"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@lionad/cx-definition": "workspace:*",
    "anysort": "^2.0.0",
    "dayjs": "^1.11.21",
    "lodash-es": "^4.18.1",
    "use-semantic-version": "^0.0.7",
    "uuid": "^14.0.1",
    "vue-concurrency": "5.0.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/uuid": "^11.0.0",
    "@vueuse/core": "^14.3.0",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "peerDependencies": {
    "@vue/shared": "^3.5.0",
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "vue": "^3.5.0"
  }
}
